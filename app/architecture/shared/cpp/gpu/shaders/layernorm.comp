// One workgroup per row: row r normalises x row (r + rowOffset) into y row r.
// LayerNorm (GPT-2): y = (x - mean) / sqrt(var + eps) * gamma + beta.
// RMSNorm (Qwen3):   y = x / sqrt(mean(x^2) + eps) * gamma.
// PA = (C, eps bits, rowOffset, flags) flags: 1 = RMSNorm. Dispatch (rows, 1).
layout(local_size_x = 128) in;
BUF(0) readonly buffer Xin { float x[]; };
BUF(1) writeonly buffer Y { float y[]; };
BUF(2) readonly buffer Gamma { float gamma[]; };
BUF(3) readonly buffer Beta { float beta[]; };

shared float red[128];

float reduceSum(float v, int l) {
    red[l] = v;
    memoryBarrierShared();
    barrier();
    for (int s = 64; s > 0; s >>= 1) {
        if (l < s) red[l] += red[l + s];
        memoryBarrierShared();
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

void main() {
    int C = PA.x;
    float eps = intBitsToFloat(PA.y);
    bool rms = (PA.w & 1) != 0;
    int row = int(gl_WorkGroupID.x);
    int l = int(gl_LocalInvocationID.x);
    int src = (row + PA.z) * C;
    int dst = row * C;

    // Both reductions always run so barrier() stays in uniform control flow.
    float a = 0.0;
    for (int i = l; i < C; i += 128) a += x[src + i];
    float total = reduceSum(a, l);
    float mean = rms ? 0.0 : total / float(C);

    float q = 0.0;
    for (int i = l; i < C; i += 128) {
        float d = x[src + i] - mean;
        q += d * d;
    }
    float rstd = inversesqrt(reduceSum(q, l) / float(C) + eps);

    if (rms) {
        for (int i = l; i < C; i += 128) y[dst + i] = x[src + i] * rstd * gamma[i];
    } else {
        for (int i = l; i < C; i += 128) y[dst + i] = (x[src + i] - mean) * rstd * gamma[i] + beta[i];
    }
}
