// matmul.comp for FP4 (E2M1) weights. Row layout (quant.h), in uvec2 units: K/16 uvec2 of codes (a 32-weight
// block is 2 uvec2; weight j sits in the low nibble of byte j, weight 16 + j in its high nibble), then the K/32
// f16 block scales, zero-padded to 16 bytes. Same parameters and dispatch as matmul.comp; K % 32 == 0.
layout(local_size_x = 64) in;
BUF(0) readonly buffer X { vec4 xv[]; };
BUF(1) readonly buffer W { uvec2 w[]; };
BUF(2) readonly buffer Bias { float bias[]; };
BUF(3) buffer Y { float y[]; };

shared vec4 red[64];

float gelu(float v) {
    float u = clamp(0.7978845608 * (v + 0.044715 * v * v * v), -15.0, 15.0);
    return 0.5 * v * (1.0 + tanh(u));
}

// Low nibbles of the four bytes -> values / 16384. In 16-bit lanes code c becomes the f16 bit pattern
// (c & 8) << 12 | (c & 7) << 9 = (c << 9) + (c & 8) * 3584. Even and odd bytes go through separately.
vec4 fp4x4(uint q) {
    uint e = q & 0x000F000Fu;
    uint o = (q >> 8) & 0x000F000Fu;
    vec2 a = unpackHalf2x16((e << 9) + (e & 0x00080008u) * 3584u);  // bytes 0 and 2
    vec2 b = unpackHalf2x16((o << 9) + (o & 0x00080008u) * 3584u);  // bytes 1 and 3
    return vec4(a.x, b.x, a.y, b.y);
}

void main() {
    int K = PA.x, N = PA.y, T = PA.z, flags = PA.w;
    int n = int(gl_WorkGroupID.x);
    int t0 = int(gl_WorkGroupID.y) * 4;
    int l = int(gl_LocalInvocationID.x);
    int K4 = K >> 2;
    int K16 = K >> 4;
    int base = n * (K16 + 2 * ((K + 255) / 256));
    int nt = min(4, T - t0);
    int x0 = (PB.x + t0) * K4;

    vec4 acc = vec4(0.0);
    for (int i = l; i < K16; i += 64) {
        uvec2 q = w[base + i];
        int b = i >> 1;
        uvec2 sv = w[base + K16 + (b >> 2)];
        uint sw = sv[(b >> 1) & 1];
        float s = halfAt(sw, uint(b));
        // This half block holds weights 8h..8h+7 (low nibbles) and 16+8h..16+8h+7 (high nibbles).
        vec4 w0 = fp4x4(q.x), w1 = fp4x4(q.y), w2 = fp4x4(q.x >> 4), w3 = fp4x4(q.y >> 4);
        int xi = x0 + 8 * b + 2 * (i & 1);
        acc.x += s * (dot(xv[xi], w0) + dot(xv[xi + 1], w1) + dot(xv[xi + 4], w2) + dot(xv[xi + 5], w3));
        if (nt > 1) {
            int xj = xi + K4;
            acc.y += s * (dot(xv[xj], w0) + dot(xv[xj + 1], w1) + dot(xv[xj + 4], w2) + dot(xv[xj + 5], w3));
        }
        if (nt > 2) {
            int xj = xi + 2 * K4;
            acc.z += s * (dot(xv[xj], w0) + dot(xv[xj + 1], w1) + dot(xv[xj + 4], w2) + dot(xv[xj + 5], w3));
        }
        if (nt > 3) {
            int xj = xi + 3 * K4;
            acc.w += s * (dot(xv[xj], w0) + dot(xv[xj + 1], w1) + dot(xv[xj + 4], w2) + dot(xv[xj + 5], w3));
        }
    }
    red[l] = acc;
    memoryBarrierShared();
    barrier();
    for (int s = 32; s > 0; s >>= 1) {
        if (l < s) red[l] += red[l + s];
        memoryBarrierShared();
        barrier();
    }
    if (l < nt) {
        vec4 r = red[0] * 16384.0;
        float v = l == 0 ? r.x : l == 1 ? r.y : l == 2 ? r.z : r.w;
        if ((flags & 4) != 0) v += bias[n];
        if ((flags & 1) != 0) v = gelu(v);
        int yi = (t0 + l) * N + PB.y + n;
        if ((flags & 2) != 0) v += y[yi];
        y[yi] = v;
    }
}
